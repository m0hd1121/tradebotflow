# Environment
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Data & DB
*.db
*.db-shm
*.db-wal
data/cache/*
data/historical/*
!data/cache/.gitkeep
!data/historical/.gitkeep

# Logs (keep audit, ignore rotating logs)
logs/signal/*
logs/trade/*
logs/risk/*
logs/learning/*
logs/system/*
!logs/signal/.gitkeep
!logs/trade/.gitkeep
!logs/risk/.gitkeep
!logs/learning/.gitkeep
!logs/system/.gitkeep
logs/audit/   # audit is immutable on VPS; not committed to repo

# IPC runtime files (generated at runtime, not committed)
ipc/signal.json
ipc/config.json
ipc/kill_flag.txt
ipc/heartbeat.txt
ipc/exec_events/*.json

# MQL5 compiled
mql5/**/*.ex5

# IDE
.vscode/
.idea/
*.swp
